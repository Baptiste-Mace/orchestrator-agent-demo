# Copier en .env et remplir. Provider "mock" = démo hors-ligne, sans clé.

# openai | azure | anthropic | ollama | mock
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini

# Clé API (inutile pour mock et ollama)
LLM_API_KEY=

# Base URL optionnelle :
#   OpenAI   : https://api.openai.com/v1  (défaut)
#   Azure    : https://<ressource>.openai.azure.com
#   Anthropic: https://api.anthropic.com/v1 (défaut)
#   Ollama   : http://localhost:11434 (défaut)
LLM_BASE_URL=
# Pour Azure uniquement :
LLM_API_VERSION=2024-06-01

LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4096

# Conditions d'arrêt
TOKEN_BUDGET=20000
MAX_STEPS=12

# Timeout HTTP par requête LLM (s) — utile pour modèles lents/cloud
LLM_REQUEST_TIMEOUT=300
